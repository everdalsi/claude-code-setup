# Frontend Configuration
# Copy to .env.local and fill in actual values

# API Configuration
VITE_API_URL=http://localhost:8000

# Environment
NODE_ENV=production

# CSRF Configuration (optional - can be read from meta tag or generated)
VITE_CSRF_TOKEN_ENDPOINT=/csrf-token

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# App Settings
VITE_APP_NAME=DropFlow
VITE_APP_VERSION=2.0.0

# Error Reporting (optional)
VITE_SENTRY_DSN=https://example@sentry.io/123456
VITE_SENTRY_ENVIRONMENT=production
